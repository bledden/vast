# Optional. Copy to .env (git-ignored) and fill in what you have.
# NVIDIA Cosmos endpoint token (hackathon: GPU_BEARER_TOKEN in /config/<team>.config on the VAST VM).
# Without it, motion events still show up, just without a description.
GPU_BEARER_TOKEN=
# Weights & Biases: traces every Cosmos call in Weave.
WANDB_API_KEY=
# Optional: POST alerts to a Slack/Discord-style webhook.
ALERT_WEBHOOK=
